---
import {asset,type World} from '../lib/data';
const {world}=Astro.props as {world:World};
---
<section class:list={['immersion',`immersion-${world}`]} data-immersion={world} aria-label="Переход в каталог">
 <div class="portal-stage">
 {world==='iznanka'&&<><div class="destination-preview preview-tvs" aria-hidden="true">{[1,2,3,4].map(i=><div class="preview-tv"><img src={asset('horror-'+i)} alt="" loading="lazy"/></div>)}</div><svg class="physical-portal keyhole-portal" viewBox="0 0 1000 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><mask id="door-hole"><rect width="1000" height="700" fill="white"/><path d="M500 235a49 49 0 0 1 26 90l26 134H448l26-134a49 49 0 0 1 26-90" fill="black"/></mask><linearGradient id="metal"><stop stop-color="#090b0c"/><stop offset=".5" stop-color="#242929"/><stop offset="1" stop-color="#080a0a"/></linearGradient></defs><g mask="url(#door-hole)"><rect width="1000" height="700" fill="url(#metal)"/><rect x="277" y="-80" width="446" height="860" rx="7" fill="none" stroke="#424a47" stroke-width="3"/><path d="M290 0v700M710 0v700M315 80h370M315 620h370" stroke="#090b0c" stroke-width="3"/><circle cx="690" cy="355" r="11" fill="#4b5048"/><path d="M680 356h-43" stroke="#686b61" stroke-width="8"/><text x="500" y="155" text-anchor="middle" fill="#71766b" font-family="monospace" font-size="14" letter-spacing="6">НЕ ОТКРЫВАТЬ</text></g><path d="M500 235a49 49 0 0 1 26 90l26 134H448l26-134a49 49 0 0 1 26-90" fill="none" stroke="#a3332b" stroke-width="4"/></svg><div class="portal-red-halo" aria-hidden="true"></div></>}
 {world==='arhiv'&&<><div class="destination-preview preview-pictures" aria-hidden="true">{[1,2,3,4].map(i=><div><img src={asset('archive-'+i)} alt="" loading="lazy"/></div>)}</div><div class="physical-portal window-portal" aria-hidden="true"><div class="window-pane left-pane"></div><div class="window-pane right-pane"></div><div class="window-beam vertical"></div><div class="window-beam horizontal"></div><span class="window-handle"></span></div></>}
 {world==='ostrov'&&<><img class="map-sea" src={asset('ostrov')} alt="" loading="lazy"/><div class="physical-map" aria-hidden="true"><div class="map-half left-map"><svg viewBox="0 0 400 600"><path d="M40 140 100 70l100 30 60 85-40 100-140 30-50-80zM160 430l100-80 70 70-20 80-110 20z"/></svg><span>ПУТЬ<br/>НАЧИНАЕТСЯ<br/>ЗДЕСЬ</span></div><div class="map-half right-map"><svg viewBox="0 0 400 600"><path d="m150 120 160 30 50 110-140 40-110-70zM50 410l90-80 110 65 50 130-170 30z"/></svg><i>✦</i></div></div></>}
 <div class="immersion-caption"><span class="eyebrow">02 / ПОГРУЖЕНИЕ</span><p>{world==='iznanka'?'По ту сторону сигнала.':world==='arhiv'?'Прошлое оставило окно открытым.':'Каждая складка — новый маршрут.'}</p><span class="scroll-hint" aria-hidden="true">↓</span></div>
 <a class="immersion-skip" href="#quests">Пропустить переход ↗</a>
 </div>
</section>
