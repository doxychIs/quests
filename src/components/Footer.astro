---
import {href,worlds,worldKeys,type World} from '../lib/data';
import HorrorLogo from './HorrorLogo.astro';
const {world}=Astro.props as {world?:World};
---
<footer class:list={['site-footer',{'portal-footer':!world}]}>
 {!world?<><div class="portal-footer-top"><p>Хорошие истории<br/>случаются <em>с вами.</em></p><a class="portal-round-link" href={href()+'#worlds'} aria-label="Выбрать свой мир">↗</a></div><div class="portal-footer-directory"><a href={href()} class="portal-footer-logo" aria-label="ИНОЕ — главная">ИНОЕ<span>По ту сторону обычного.</span></a><nav aria-label="Миры квестов"><span>Выберите настроение</span>{worldKeys.map(w=><a href={href(w+'/')}>{worlds[w].name} <small>{worlds[w].age}</small></a>)}</nav><nav aria-label="О проекте"><span>Перед первой историей</span><a href={href('about/')}>Как это устроено</a><a href={href('certificates/')}>Подарочные приглашения</a><a href={href('contacts/')}>Контакты</a><a href={href('rules/')}>Правила участия</a></nav></div></>:<>
 <div class="footer-top"><a href={href()} class:list={['brand',{'brand-horror':world==='iznanka'}]} aria-label={world==='iznanka'?'Изнанка / ИНОЕ — выбор мира':undefined}>{world==='iznanka'?<HorrorLogo/>:<span>ИНОЕ</span>}</a><p>{world==='iznanka'?<>Сигнал потерян.<br/>Выход ещё здесь.</>:<>Квесты, в которых<br/>вы по другую сторону.</>}</p><a href={href()} class="text-link">К выбору мира</a></div>
 </>}
 <div class="footer-bottom"><span>ПЕРМЬ / ДЕМОНСТРАЦИОННЫЙ ПРОЕКТ © 2026</span><nav aria-label="Информация"><a href={href('contacts/')}>Контакты</a><a href={href('rules/')}>Правила</a><a href={href('privacy/')}>Конфиденциальность</a></nav><button class="back-top">Наверх ↑</button></div>
</footer>
