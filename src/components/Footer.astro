---
import {href,worlds,worldKeys,type World} from '../lib/data';
import HorrorLogo from './HorrorLogo.astro';
import BrandWordmark from './BrandWordmark.astro';
const {world}=Astro.props as {world?:World};
---
<footer class:list={['site-footer',{'portal-footer':!world}]}>
 {!world?<div class="hub-footer-content"><a href={href()} class="hub-wordmark" aria-label="ИНОЕ — главная"><BrandWordmark id="footer-wordmark"/></a><nav aria-label="Миры квестов">{worldKeys.map(w=><a href={href(w+'/')}>{worlds[w].name}</a>)}</nav><nav aria-label="О проекте"><a href={href('about/')}>О проекте</a><a href={href('certificates/')}>Приглашения</a><a href={href('contacts/')}>Контакты</a></nav></div>:<>
 <div class="footer-top"><a href={href()} class:list={['brand',{'brand-horror':world==='iznanka'}]} aria-label={world==='iznanka'?'Изнанка / ИНОЕ — выбор мира':undefined}>{world==='iznanka'?<HorrorLogo/>:<span>ИНОЕ</span>}</a><p>{world==='iznanka'?<>Сигнал потерян.<br/>Выход ещё здесь.</>:<>Квесты, в которых<br/>вы по другую сторону.</>}</p><a href={href()} class="text-link">К выбору мира</a></div>
 </>}
 <div class="footer-bottom"><span>Пермь · Демонстрационный проект © 2026</span><nav aria-label="Информация"><a href={href('rules/')}>Правила</a><a href={href('privacy/')}>Конфиденциальность</a></nav><button class="back-top">Наверх</button></div>
</footer>
