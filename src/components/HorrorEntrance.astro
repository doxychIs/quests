---
import {href} from '../lib/data';
import GraphicText from './GraphicText.astro';
import MediaLoading from './MediaLoading.astro';
import SceneLoading from './SceneLoading.astro';
import '../styles/horror-cinema.css';
import '../styles/horror-passage.css';
---
<MediaLoading world="iznanka"/>
<section class="horror-film" aria-label="Заброшенный коридор с приоткрытой дверью">
 <img class="film-poster" src={href('assets/horror-hero-poster.jpg?v=20261019')} alt="" aria-hidden="true" fetchpriority="high" width="1280" height="720"/>
 <video data-horror-film data-src={href('assets/horror-hero.mp4?v=20261019')} data-src-mobile={href('assets/horror-hero-mobile.mp4?v=20261019')} poster={href('assets/horror-hero-poster.jpg?v=20261019')} muted loop playsinline preload="none" width="1280" height="720" aria-label="Туман и пыль в заброшенном коридоре, отпечаток ладони на стене"></video>
 <div class="film-vignette" aria-hidden="true"></div>
 <div class="film-copy">
  <span class="film-age">18+</span>
  <h1><GraphicText text="Не" variant="title" flicker/><br/><GraphicText text="оборачивайтесь." variant="blood" flicker/></h1>
  <p class="film-description">За этой дверью ваши страхи обретают форму.<br/> Осталось сделать первый шаг.</p>
 </div>
 <div class="film-tools"><button type="button" data-film-pause aria-pressed="false">Пауза</button><a href="#quests">Выбрать квест</a></div>
 <a href="#passage" class="film-scroll"><span>Листайте вниз</span></a>
</section>
<section id="passage" class="horror-passage" data-horror-door aria-label="Проход через замок в телевизионную комнату. Прокручивайте, чтобы двигаться.">
 <div class="horror-door-sticky passage-sticky">
  <section class="passage-room" aria-label="Телевизионная комната"><slot/></section>
  <div class="passage-caption"><span data-passage-caption>Продолжайте листать. Дверь уже открыта.</span></div>
  <a class="passage-skip" href="#quests">К выбору квеста</a>
  <SceneLoading/>
 </div>
 <span id="quests" class="room-arrival" aria-hidden="true"></span>
</section>
<style>
 .horror-film .film-vignette{background:linear-gradient(90deg,#030303b8,transparent 80%),linear-gradient(0deg,#030303d9,transparent 70%)}
 .film-copy{position:absolute;left:clamp(28px,6vw,100px);right:28px;bottom:22%;z-index:1;color:#f1e9df;text-shadow:0 2px 30px #0008}
 .film-eyebrow{display:flex;align-items:center;gap:20px;font:11px/1.4 var(--sans);letter-spacing:.22em;margin:0 0 26px}
 .film-eyebrow span{font-size:10px;letter-spacing:.04em;border:1px solid #f1e9df55;padding:5px 7px}
 .film-copy h1{font:400 clamp(52px,7.5vw,112px)/.91 var(--serif);letter-spacing:-.035em;margin:0 0 26px;max-width:100%}
 .film-description{font:400 clamp(14px,1.2vw,17px)/1.7 var(--sans);color:#d4c9bf;margin:0}
 .horror-film .film-scroll{left:50%;bottom:30px;transform:translateX(-50%);width:auto;height:auto;display:flex;flex-direction:column;gap:12px;align-items:center;opacity:1;color:#e3d8cb;font:11px/1.4 var(--sans);letter-spacing:.15em;text-transform:uppercase;padding:12px 24px;z-index:2;white-space:nowrap}
 .film-scroll-arrow{font-size:25px;line-height:1;transition:transform .25s}
 .film-scroll:hover .film-scroll-arrow{transform:translateY(5px)}
 @media(max-width:760px){.film-copy{bottom:24%;left:28px;right:24px}.film-copy h1{font-size:clamp(32px,8.9vw,65px);margin-bottom:22px}.film-eyebrow{font-size:10px;margin-bottom:22px}.film-description{font-size:13px;max-width:285px}.film-description br{display:none}.horror-film .film-scroll{bottom:22px}}
 @media(max-height:550px) and (min-width:761px){.film-copy{bottom:25%}.film-copy h1{font-size:48px;margin-bottom:14px}.film-eyebrow{margin-bottom:14px}.horror-film .film-scroll{bottom:10px}}
 @media(prefers-reduced-motion:reduce){.film-scroll-arrow{transition:none}}
 :global(.calm) .film-scroll-arrow{transition:none}
</style>
<div class="horror-entry-veil" aria-hidden="true"></div>
<script>import {initHorrorCinema} from '../scripts/horror-cinema';initHorrorCinema();</script>
