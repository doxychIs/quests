---
import {href} from '../lib/data';
import {worldMedia} from '../lib/world-media';
import ArchiveHero from './ArchiveHero.astro';
import MediaLoading from './MediaLoading.astro';
const {world}=Astro.props as {world:'arhiv'|'ostrov'};
const media=worldMedia[world].hero;
---
{world==='arhiv'?<ArchiveHero/>:<><MediaLoading world={world}/><section class:list={['story-hero',`story-hero-${world}`]} aria-labelledby="world-title">
 <div class="story-hero-media" data-hero-media>
  <img src={href(`assets/${media.image}`)} alt="" fetchpriority="high" width="1280" height="720"/>
  <video data-hero-video data-lazy-video data-src={href(media.video)} data-src-mobile={href(media.mobile)} poster={href(`assets/${media.image}`)} muted loop playsinline preload="none" width="1280" height="720" aria-hidden="true"/>
 </div>

  <div class="island-hero-horizon" aria-hidden="true"></div>
  <div class="island-hero-copy"><p class="hero-kicker"><span class="expedition-dot" aria-hidden="true"></span> Семейная экспедиция · от 6 лет</p><h1 id="world-title">Остров<span>маленьких<br/>больших открытий.</span></h1><p>Что за поворотом: джунгли, вечные льды<br/>или вулкан? Решает ваша команда.</p><a class="expedition-button" href="#passage">Вперёд, исследователи! <span aria-hidden="true">↗</span></a></div>
  <div class="island-hero-note"><span aria-hidden="true">✳</span><p>Четыре мира.<br/>Одно большое «ух ты!»</p><svg viewBox="0 0 150 80" aria-hidden="true"><path d="M10 8Q100 0 102 62m-16-9 16 9 10-17"/></svg></div>
  <div class="expedition-stamp" aria-label="Четыре маршрута для одной команды"><span>БЮРО ПРИКЛЮЧЕНИЙ</span><strong>04</strong><span>МАРШРУТА · ВЫБИРАЙТЕ</span></div>
  <div class="hero-video-tools"><span class="hero-video-state" data-hero-video-state role="status"></span><button type="button" data-hero-video-pause aria-pressed="false">Пауза видео</button></div>
  <div class="story-hero-bottom"><span>Дети ведут. Взрослые тоже играют.</span><a href="#passage">Посмотреть с высоты <span aria-hidden="true">↓</span></a><a href="#quests">Сразу к приключениям ↗</a></div>

</section></>}
