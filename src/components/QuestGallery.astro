---
import {quests,href,asset,type World} from '../lib/data';
import HorrorRoom from './HorrorRoom.astro';
import {islandIdentities} from '../lib/world-media';
const {world}=Astro.props as {world:World};
const list=quests.filter(q=>q.world===world);
---
{world==='iznanka'&&<HorrorRoom/>}
{world==='arhiv'&&<div class="archive-collection">{list.map((q,i)=><article class:list={['archive-case',`archive-case-${i}`]} data-world-reveal><span class="case-number" aria-hidden="true">{q.index}</span><a class="archive-frame" href={href(`arhiv/quests/${q.slug}/`)} data-quest-link aria-label={`Открыть дело «${q.name}»`}><div class="archive-canvas"><img src={asset(q.image)} alt={q.synopsis} loading="lazy" width="1536" height="1024"/><span class="archive-frame-light" aria-hidden="true"></span></div><span class="frame-invitation">У истории есть продолжение ↗</span></a><div class="archive-caption"><span class="case-genre">Дело № {q.index} · {q.genre}</span><h3><a href={href(`arhiv/quests/${q.slug}/`)}>{q.name}</a></h3><p>{q.synopsis}</p><dl class="case-facts"><div><dt>Возраст</dt><dd>{q.age}</dd></div><div><dt>Время</dt><dd>{q.duration} минут</dd></div><div><dt>Команда</dt><dd>{q.players.join('–')} человек</dd></div></dl><a class="manuscript-link" href={href(`arhiv/quests/${q.slug}/`)}>Читать дело <span aria-hidden="true">↗</span></a></div></article>)}</div>}
{world==='ostrov'&&<div class="expedition-collection">{list.map((q,i)=>{const identity=islandIdentities[i];return <article class:list={['expedition-quest',`quest-${identity.theme}`]} data-world-reveal><div class="expedition-cover"><a href={href(`ostrov/quests/${q.slug}/`)} data-quest-link aria-label={`Исследовать квест «${q.name}»`}><img src={asset(q.image)} alt={q.synopsis} loading="lazy" width="1536" height="1024"/><span class="quest-environment" aria-hidden="true"></span></a><span class="route-tag">Маршрут {q.index} / {identity.place}</span><span class="route-symbol" aria-hidden="true">{identity.symbol}</span><a class="route-arrow" href={href(`ostrov/quests/${q.slug}/`)} aria-label={`Открыть ${q.name}`}>↗</a></div><div class="expedition-quest-copy"><p class="route-note">{identity.note}</p><h3><a href={href(`ostrov/quests/${q.slug}/`)}>{q.name}</a></h3><p class="route-description">{q.synopsis}</p><div class="route-facts"><span>{q.age}</span><span>{q.duration} минут</span><span>{q.players.join('–')} игроков</span></div><details class="route-discovery"><summary>Что будем искать?</summary><p>{q.task}</p></details><a class="text-link" href={href(`ostrov/quests/${q.slug}/`)}>Вот наше приключение ↗</a></div></article>})}</div>}
