---
import {quests,asset,href} from '../lib/data';
import {horrorPhotos} from '../lib/horror-settings';
import '../styles/horror-photos.css';
const stories=quests.filter(q=>q.world==='iznanka');
---
<section class="horror-photos section-pad" id="frames" data-photo-gallery aria-labelledby="photo-gallery-title">
 <header class="photo-gallery-heading"><div><span class="photo-overline">Найденная запись / 08 кадров</span><h2 id="photo-gallery-title">Сигнал<br/>ещё идёт.</h2></div><p>Четыре места по ту сторону экрана.<br/>Листайте запись. Попробуйте рассмотреть то, что осталось в кадре.</p></header>
 <div class="photo-tv" role="region" aria-roledescription="карусель" aria-label="Телевизор с галереей локаций" tabindex="0" data-photo-tv>
  <div class="photo-tv-trim" aria-hidden="true"><span>ИЗНАНКА</span><span>ПРИЁМНИК ИЗОБРАЖЕНИЙ</span></div>
  <div class="photo-tv-body">
   <div class="photo-glass">
    <div class="photo-screen-status" aria-hidden="true"><span><i></i> <span data-photo-signal>ЗАПИСЬ</span></span><span data-photo-screen-position>01 / 08</span></div>
    <div class="photo-contact-sheet" data-photo-track>{horrorPhotos.map((photo,i)=>{const quest=stories.find(q=>q.slug===photo.quest)!;return <figure data-photo-card data-photo-quest={photo.quest} hidden={i!==0} aria-label={`Кадр ${i+1}: ${photo.title}`}>
     <a class="reportage-photo" href={asset(photo.image)} data-reportage-open data-photo-title={photo.title} data-photo-story={quest.name} data-photo-link={href(`iznanka/quests/${quest.slug}/#location`)} aria-label={`Увеличить кадр: ${photo.title}. ${quest.name}`}><img src={asset(photo.image)} width="1200" height="900" alt={photo.alt} loading="lazy" decoding="async"/><canvas class="photo-pixels" width="96" height="72" aria-hidden="true"></canvas><span class="photo-enlarge" aria-hidden="true">↗</span></a>
     <figcaption><span>{quest.name}</span><h3>{photo.title}</h3></figcaption>
    </figure>})}</div>
    <p class="photo-screen-error" data-photo-screen-error role="status" hidden>Кадр не загрузился.<br/>Попробуйте следующий.</p>
    <div class="photo-glass-surface" aria-hidden="true"></div>
   </div>
   <aside class="photo-tv-hardware" aria-hidden="true"><span>НАСТРОЙКА</span><div class="photo-dial"><i></i></div><div class="photo-small-dial"></div><div class="photo-speaker"></div><span class="photo-power"><i></i> СИГНАЛ</span></aside>
  </div>
  <div class="photo-tv-controls"><div class="photo-transport"><button type="button" data-photo-browse="-1" aria-label="Предыдущий снимок" disabled><span aria-hidden="true">←</span></button><span data-photo-count role="status" aria-live="polite" aria-atomic="true">Кадр 1 из 8</span><button type="button" data-photo-browse="1" aria-label="Следующий снимок" disabled><span aria-hidden="true">→</span></button></div><button class="photo-sharp-button" type="button" data-photo-sharp aria-pressed="false" disabled><span aria-hidden="true">▧</span> Прояснить кадр</button></div>
  <div class="photo-channel-bar"><span aria-hidden="true">КАНАЛЫ</span><div class="photo-filters" role="group" aria-label="Выбрать историю"><button type="button" data-photo-filter="all" aria-pressed="true">Все записи</button>{stories.map((q)=><button type="button" data-photo-filter={q.slug} aria-pressed="false">{q.name}</button>)}</div></div>
 </div>
 <div class="photo-gallery-foot"><p class="photo-desktop-hint">Наведите на экран — изображение станет чётким.<br/>Нажмите на снимок, чтобы открыть его крупно.</p><p class="photo-touch-hint">Листайте кадры пальцем или стрелками.<br/>«Прояснить кадр» убирает пиксели.</p><p class="photo-gallery-note">Сгенерированные кадры декораций, а не фотографии действующей площадки.</p></div>
 <noscript><p class="photo-fallback">Записи без интерактивного телевизора: {horrorPhotos.map((photo)=><a href={asset(photo.image)}>{photo.title} ↗</a>)}</p></noscript>
 <dialog class="reportage-dialog" data-photo-dialog aria-labelledby="reportage-title"><div class="reportage-toolbar"><span data-photo-position aria-live="polite"></span><button type="button" data-photo-close aria-label="Закрыть галерею">Закрыть ×</button></div><div class="reportage-large"><img alt="" data-photo-large/><p data-photo-error role="status" hidden>Не удалось загрузить кадр.</p></div><div class="reportage-caption"><div><h3 id="reportage-title" data-photo-caption></h3><p>Визуализация декораций · сгенерированный кадр</p><a href="#" data-photo-quest-link>О локации и актёре ↗</a></div><div class="reportage-arrows"><button type="button" data-photo-step="-1" aria-label="Предыдущий кадр">←</button><button type="button" data-photo-step="1" aria-label="Следующий кадр">→</button></div></div></dialog>
</section>
<script>import {initReportage} from '../scripts/reportage';initReportage();</script>
