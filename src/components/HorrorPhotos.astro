---
import {quests,asset,href} from '../lib/data';
import {horrorPhotos} from '../lib/horror-settings';
import '../styles/horror-photos.css';
const stories=quests.filter(q=>q.world==='iznanka');
const notes:Record<string,string>={'ward-room':'здесь кто-то дежурит','phone-room':'не поднимай трубку','factory-room':'смена ещё не закончилась','forest-room':'тропа снова привела сюда'};
---
<section class="horror-photos section-pad" id="frames" data-photo-gallery aria-labelledby="photo-gallery-title">
 <header class="photo-gallery-heading"><div><span class="photo-overline">Оставлено после закрытия</span><h2 id="photo-gallery-title">Кто-то<br/><span class="photo-heading-offset">был здесь.</span></h2></div><div class="photo-heading-aside"><p>Палата, квартира, цех и сторожка.<br/>Сгенерированные кадры в стиле случайной съёмки.</p><span class="photo-heading-note photo-hand" aria-hidden="true">не стирать<svg viewBox="0 0 110 85"><path d="M88 8C102 30 65 32 48 38S14 54 25 74M12 64l13 11 8-16"/></svg></span></div></header>
 <div class="photo-gallery-tools"><div class="photo-filters" role="group" aria-label="Показать кадры выбранного квеста"><button type="button" data-photo-filter="all" aria-pressed="true"><span aria-hidden="true">↳</span> Все кадры</button>{stories.map((q,i)=><button type="button" data-photo-filter={q.slug} aria-pressed="false"><span aria-hidden="true">0{i+1}.</span> {q.name}</button>)}</div><p data-photo-count role="status" aria-live="polite">Показано кадров: {horrorPhotos.length}</p></div>
 <div class="photo-contact-sheet">{horrorPhotos.map((photo,i)=>{const quest=stories.find(q=>q.slug===photo.quest)!;return <figure data-photo-card data-photo-quest={photo.quest}>
  <a class="reportage-photo" href={asset(photo.image)} data-reportage-open data-photo-title={photo.title} data-photo-story={quest.name} data-photo-link={href(`iznanka/quests/${quest.slug}/#location`)} aria-label={`Увеличить кадр: ${photo.title}. ${quest.name}`}><img src={asset(photo.image+'-thumb')} width="600" height="450" alt={photo.alt} loading="lazy" decoding="async"/><span class="photo-enlarge" aria-hidden="true">↗</span></a>
  <figcaption><span class="photo-number">{String(i+1).padStart(2,'0')} /</span><div><span>{quest.name}</span><p class="photo-title photo-hand">{photo.title}</p></div></figcaption>
  {notes[photo.key]&&<span class="photo-scribble photo-hand" aria-hidden="true">{notes[photo.key]}</span>}
 </figure>})}</div>
 <p class="photo-gallery-note">Кадры созданы для концепции «Изнанки» и не являются фотографиями действующей площадки. Описание каждой локации и роли актёра — на странице квеста.</p>
 <dialog class="reportage-dialog" data-photo-dialog aria-labelledby="reportage-title"><div class="reportage-toolbar"><span data-photo-position aria-live="polite"></span><button type="button" data-photo-close aria-label="Закрыть галерею">Закрыть ×</button></div><div class="reportage-large"><img alt="" data-photo-large/><p data-photo-error role="status" hidden>Не удалось загрузить кадр.</p></div><div class="reportage-caption"><div><h3 id="reportage-title" data-photo-caption></h3><p>Визуализация декораций · сгенерированный кадр</p><a href="#" data-photo-quest-link>О локации и актёре ↗</a></div><div class="reportage-arrows"><button type="button" data-photo-step="-1" aria-label="Предыдущий кадр">←</button><button type="button" data-photo-step="1" aria-label="Следующий кадр">→</button></div></div></dialog>
</section>
<script>import {initReportage} from '../scripts/reportage';initReportage();</script>
