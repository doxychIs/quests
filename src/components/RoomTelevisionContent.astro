---
import {asset,href,quests} from '../lib/data';
import {horrorPhotos,horrorSettings} from '../lib/horror-settings';
import GraphicText from './GraphicText.astro';
import Games from './Games.astro';
import '../styles/room-television-content.css';
const horrorQuests=quests.filter(q=>q.world==='iznanka');
---
<!-- These are the phosphor contents only. The room supplies the physical cabinets,
     curved glass, projection and camera. Keep every surface inside this ancestor. -->
<div class="room-tv-content" data-room-tv-content>
 <section class="room-surface room-wall-board" data-room-surface="team" data-room-interactive aria-labelledby="room-team-title" tabindex="-1">
  <header class="room-screen-header"><div><h2 id="room-team-title">Не входите одни.</h2></div><button type="button" data-room-leave aria-label="Отойти от койки">В комнату</button></header>
  <div class="room-team-fixed" aria-label="Подобрать квест по количеству игроков">
   <div class="team-picker" data-team-picker><fieldset class="team-size"><legend>Сколько вас?</legend><div>{[2,3,4,5,6].map(n=><label><input type="radio" name="team-size" value={n} checked={n===4}/><span>{n}</span></label>)}</div></fieldset><p class="team-status" data-team-status role="status" aria-live="polite" aria-atomic="true">Подходят все 4 квеста</p><ul class="team-quests">{horrorQuests.map(q=><li data-team-quest data-min={q.players[0]} data-max={q.players[1]} data-suitable="true"><div><h3>{q.name}</h3><p>{q.players.join('–')} игроков · {q.duration} мин</p></div><a href={href(`iznanka/book/${q.slug}/?players=4`)} data-team-book aria-label={`Выбрать квест «${q.name}» для 4 игроков`}>Выбрать</a><span class="team-unavailable" data-team-unavailable hidden></span></li>)}</ul></div>
  </div>
 </section>

 <section class="room-surface room-gallery room-projection-content" data-room-surface="gallery" data-room-projector-on="false" data-room-interactive aria-labelledby="room-gallery-title" tabindex="-1">
  <header class="room-screen-header"><div><span class="room-screen-overline">Кинопроекционная · плёнка с поста</span><h2 id="room-gallery-title"><GraphicText text="То, что осталось." variant="title"/></h2></div><button type="button" data-room-projector-power aria-pressed="false">Включить проектор</button><button type="button" data-room-leave aria-label="Отойти от экрана">Отойти</button></header>
  <p class="room-projector-off">Проектор выключен. Включите аппарат, чтобы рассмотреть плёнку.</p>
  <div class="room-gallery-filters" role="group" aria-label="Выбрать квест"><button type="button" data-room-photo-filter="all" aria-pressed="true">Все записи</button>{horrorQuests.map(q=><button type="button" data-room-photo-filter={q.slug} aria-pressed="false">{q.name}</button>)}</div>
  <div class="room-gallery-track" data-room-photo-track tabindex="0" aria-label="Кадры локаций. Стрелки клавиатуры меняют снимок.">
   {horrorPhotos.map((photo,i)=>{const quest=horrorQuests.find(q=>q.slug===photo.quest)!;return <figure data-room-photo={photo.quest} hidden={i!==0}>
    <button class="room-gallery-image" type="button" data-room-photo-zoom aria-label={`Рассмотреть кадр: ${photo.title}`}><img data-room-src={asset(photo.image)} alt={photo.alt} width="1200" height="900" loading="lazy" decoding="async"/><span class="room-image-enlarge">Рассмотреть кадр</span></button>
    <figcaption><div><h3>{photo.title}</h3><span>{quest.name}</span></div><a href={href(`iznanka/quests/${quest.slug}/#location`)}>О локации и актёре</a></figcaption>
   </figure>})}
   <p class="room-image-error" data-room-photo-error role="status" hidden>Кадр не загрузился. Переключите запись.</p>
  </div>
  <div class="room-gallery-transport"><button type="button" data-room-photo-step="-1" aria-label="Предыдущий кадр">Назад</button><span data-room-photo-position role="status" aria-live="polite">Кадр 1 из 8</span><button type="button" data-room-photo-step="1" aria-label="Следующий кадр">Далее</button><button type="button" data-room-photo-clear aria-pressed="false" aria-label="Прояснить кадр">Чётче</button><button type="button" data-room-photo-tuner aria-label="Ручка переключения кадров"><span aria-hidden="true"></span>Кадр</button></div>
  <p class="room-film-hint">Прокрутка — следующий кадр. После последнего — дальше по комнате.</p>
  <p class="room-screen-note">Визуализации декораций · сгенерированные кадры, а не фотографии действующей площадки.</p>
 </section>

 <section class="room-surface room-game room-laptop-content" data-room-surface="game" data-room-interactive aria-labelledby="room-game-title" tabindex="-1">
  <header class="room-screen-header"><div><span class="room-screen-overline">Терминал на тумбочке · палата 06</span><h2 id="room-game-title"><GraphicText text="По ту сторону сигнала" variant="title"/></h2></div><button type="button" data-room-leave aria-label="В комнату"><span class="room-label-desktop">В комнату</span><span class="room-label-compact" aria-hidden="true">В комнату</span></button></header>
  <p class="room-game-intro" id="room-game-instructions">Три этапа. Стрелки / WASD или палец. Стена вернёт к контрольной точке.</p>
  <div class="room-game-content" aria-describedby="room-game-instructions"><Games world="iznanka" embedded/></div>
 </section>

 {horrorQuests.map((q,i)=>{const setting=horrorSettings[q.slug];return <section class="room-surface room-quest" data-room-surface={`quest_${i}`} data-room-quest={q.slug} data-room-interactive aria-labelledby={`room-quest-title-${q.slug}`} tabindex="-1">
  <button class="room-broadcast-image" type="button" data-room-broadcast-zoom data-room-frame-src={asset(horrorPhotos.find(photo=>photo.quest===q.slug)!.image)} data-room-frame-alt={`Кадр квеста «${q.name}»`} aria-label={`Рассмотреть кадр квеста «${q.name}»`}><span class="sr-only">Рассмотреть кадр</span></button>
  <header class="room-screen-header"><div><span class="room-screen-overline">{q.genre} · {q.age}</span><h2 id={`room-quest-title-${q.slug}`}><GraphicText text={q.name} variant="title" flicker seed={i+10}/></h2></div><button type="button" data-room-leave aria-label="В комнату"><span class="room-label-desktop">В комнату</span><span class="room-label-compact" aria-hidden="true">В комнату</span></button></header>
  <nav class="room-screen-tabs" aria-label={`Информация о квесте «${q.name}»`}><button type="button" data-room-tab="story" aria-pressed="true">Сюжет</button><button type="button" data-room-tab="details" aria-pressed="false">Сведения</button><button type="button" data-room-tab="place" aria-pressed="false">Локация</button><button type="button" data-room-tab="frames" aria-pressed="false">Кадры</button><button type="button" data-room-readability aria-pressed="false">Крупнее текст</button></nav>
  <div class="room-screen-scroll" tabindex="0" aria-label={`Читать о квесте «${q.name}»`}>
   <div data-room-pane="story"><p class="room-synopsis">{q.synopsis}</p><p>{q.story}</p><h3>Ваша задача</h3><p>{q.task}</p></div>
   <div data-room-pane="details" hidden><dl class="room-quest-metrics"><div><dt>Возраст</dt><dd>{q.age}</dd></div><div><dt>Время</dt><dd>{q.duration} минут</dd></div><div><dt>Команда</dt><dd>{q.players.join('–')} игроков</dd></div><div><dt>Страх</dt><dd aria-label={`${q.level} из 5`}>{'■'.repeat(q.level)}{'□'.repeat(5-q.level)} <small>{q.level}/5</small></dd></div></dl><h3>Правила участия</h3><ul>{q.rules.map(rule=><li>{rule}</li>)}</ul></div>
   <div data-room-pane="place" hidden><h3>{setting.place}</h3><p>{setting.description}</p><p class="room-location-spaces">{setting.spaces.join(' · ')}</p><h3>{setting.actor}</h3><p>{setting.format}</p><p>{setting.performance}</p><p class="room-screen-note">Устройство площадки и роли актёров — часть концепции квеста.</p></div>
   <div class="room-quest-frames" data-room-pane="frames" hidden>{q.gallery.map((name,n)=><figure><button type="button" data-room-frame-open data-room-frame-src={asset(name)} data-room-frame-alt={`Визуализация декорации квеста «${q.name}», кадр ${n+1}`} aria-label={`Рассмотреть кадр ${n+1} квеста «${q.name}»`}><img data-room-src={asset(name)} alt={`Визуализация декорации квеста «${q.name}», кадр ${n+1}`} width="1200" height="900" loading="lazy" decoding="async"/><span>Рассмотреть кадр</span></button><figcaption>Визуализация декораций и персонажей</figcaption></figure>)}</div>
  </div>
  <footer class="room-quest-actions"><a class="room-primary-action" href={href(`iznanka/book/${q.slug}/`)} aria-label="Выбрать сеанс"><span class="room-label-desktop">Выбрать сеанс</span><span class="room-label-compact" aria-hidden="true">Сеансы</span></a><a href={href(`iznanka/quests/${q.slug}/`)} aria-label="Полная страница квеста"><span class="room-label-desktop">Полная страница квеста</span><span class="room-label-compact" aria-hidden="true">О квесте</span></a><small>Демонстрационный квест · запись в деморежиме</small></footer>
  <div class="room-inline-viewer" data-room-inline-viewer hidden role="dialog" aria-modal="false" aria-label={`Кадр квеста «${q.name}»`}><button type="button" data-room-frame-close>Вернуться к квесту</button><img data-room-frame-large alt=""/></div>
 </section>})}

 <footer class="room-surface room-info" role="contentinfo" data-room-surface="info" data-room-interactive aria-labelledby="room-info-title" tabindex="-1">
  <header class="room-screen-header"><div><span class="room-screen-overline">ИНОЕ / ИЗНАНКА</span><h2 id="room-info-title">Пост дежурного</h2></div><button type="button" data-room-leave aria-label="В комнату"><span class="room-label-desktop">В комнату</span><span class="room-label-compact" aria-hidden="true">В комнату</span></button></header>
  <nav class="room-screen-tabs" aria-label="Об отделении"><button type="button" data-room-tab="directory" aria-pressed="true">Информация</button><button type="button" data-room-tab="record" aria-pressed="false">Журнал</button><button type="button" data-room-tab="rules" aria-pressed="false">Правила</button><button type="button" data-room-readability aria-pressed="false">Крупнее текст</button></nav>
  <div class="room-screen-scroll" tabindex="0" aria-label="Читать журнал и правила участия">
   <div data-room-pane="directory"><p class="room-synopsis">ИНОЕ / ИЗНАНКА · Пермь</p><p>Четыре хоррор-квеста. Команды от 2 до 6 игроков. Здесь — всё, что нужно знать перед визитом.</p><nav class="room-record-actions room-footer-links" aria-label="Информация сайта"><a href={href('contacts/')}>Контакты</a><a href={href('certificates/')}>Сертификаты</a><a href={href('rules/')}>Правила участия</a><a href={href('privacy/')}>Конфиденциальность</a><a href={href()}>Другие миры</a><button type="button" data-room-navigate="quests">Выбрать квест</button></nav><p class="room-screen-note">ИНОЕ · {new Date().getFullYear()}<br/>Демонстрационный сайт: квесты и площадки — вымышленная концепция. Запись работает в деморежиме.</p></div>
   <div data-room-pane="record" hidden><p class="room-synopsis">Отделение закрыли после последнего обхода. Сегодня камеры снова включились.</p><p>В шестой палате нашли тело. Дежурный врач исчез. В журнале осталось одно время — 03:17. От койки к двери тянутся следы, а отпечаток на стене обрывается у выключателя. Кто-то успел погасить свет.</p><p>Камера сохранила восемь кадров: палата, телефон, пустой цех и дом в лесу. Одна из этих деталей могла попасть сюда не случайно.</p><p>На четырёх старых телевизорах — четыре квеста. В каждом есть свой путь по ту сторону этой двери.</p><div class="room-record-actions"><button type="button" data-room-navigate="gallery">Посмотреть записи</button><button type="button" data-room-navigate="quests">Выбрать квест</button><button type="button" data-room-navigate="team">К списку у койки</button></div></div>

   <div data-room-pane="rules" hidden><h3>Темнота. Ясные правила.</h3><p>Атмосфера может быть тревожной. Правила участия должны быть понятными.</p><dl class="room-quest-metrics"><div><dt>Возраст</dt><dd>18+</dd></div><div><dt>Квест</dt><dd>60–75 минут</dd></div><div><dt>Команда</dt><dd>2–6 человек</dd></div></dl><details class="room-faq"><summary>Можно ли остановиться?</summary><p>Да. В сценариях предусмотрены подсказки и возможность завершить участие. Условия реальной площадки уточняются до записи.</p></details><details class="room-faq"><summary>Как выбрать уровень страха?</summary><p>У каждого квеста указаны интенсивность, состав команды и особенности участия. Начните с «Лесника», если предпочитаете менее напряжённую атмосферу.</p></details><div class="room-preferences-controls" role="group" aria-label="Настройки впечатлений"><button type="button" class="sound-toggle" aria-pressed="false" aria-label="Включить звук"><span class="sound-label">Звук выкл.</span></button><button type="button" class="motion-toggle" aria-pressed="false" aria-label="Уменьшить движение"><span class="motion-label">Движение вкл.</span></button><button type="button" class="settings-toggle" aria-label="Настройки впечатлений">Настройки</button></div><nav class="room-record-actions" aria-label="Информация и другие миры"><a href={href('rules/')}>Все правила участия</a><a href={href('contacts/')}>Контакты</a><a href={href('certificates/')}>Сертификаты</a><a href={href('privacy/')}>Конфиденциальность</a><a href={href()}>Выбрать мир</a></nav><p class="room-screen-note">ИНОЕ · Пермь · {new Date().getFullYear()}<br/>Демонстрационный сайт. Квесты, площадки и персонажи — вымышленная концепция. Запись работает в деморежиме.</p></div>
  </div>
 </footer>
</div>
<script>import {initRoomTelevisionContent} from '../scripts/room-television-content';initRoomTelevisionContent();</script>
