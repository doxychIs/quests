---
import {wordmarkGlyphs} from '../lib/brand-wordmark';
interface Props {id:string;animated?:boolean}
const {id,animated=false}=Astro.props;
---
<span class:list={['inoe-wordmark',{'hub-logo-volume':animated}]} aria-hidden="true">
 <svg class="inoe-wordmark-defs" width="0" height="0" focusable="false"><defs>
  <linearGradient id={`${id}-pearl`} x1=".15" y1="0" x2=".8" y2="1" gradientUnits="objectBoundingBox"><stop class="brand-stop-light" offset="0"/><stop class="brand-stop-mid" offset=".43"/><stop class="brand-stop-light" offset=".72"/><stop class="brand-stop-dark" offset="1"/></linearGradient>
  <linearGradient id={`${id}-fold`} x1="0" y1=".8" x2="1" y2=".1"><stop class="brand-stop-shadow"/><stop class="brand-stop-dark" offset=".55"/><stop class="brand-stop-mid" offset="1"/></linearGradient>
  {wordmarkGlyphs.map((glyph,index)=><clipPath id={`${id}-clip-${index}`}><path d={glyph.outline} fill-rule="evenodd"/></clipPath>)}
 </defs></svg>
 {wordmarkGlyphs.map((glyph,index)=><span class:list={['inoe-wordmark-glyph',{'hub-logo-letter':animated}]}>
  {animated&&Array.from({length:6},(_,i)=><span class="hub-logo-side" style={`--depth-step:${(6-i)/6};--side-color:rgb(${47+i*6} ${52+i*6} ${60+i*6})`}><svg viewBox="0 0 200 200" focusable="false"><path d={glyph.outline} fill="currentColor" fill-rule="evenodd"/></svg></span>)}
  <svg class:list={['inoe-wordmark-face',{'hub-logo-metric':animated}]} viewBox="0 0 200 200" focusable="false">
   <path class="inoe-wordmark-silhouette" d={glyph.outline} fill={`url(#${id}-pearl)`} fill-rule="evenodd"/>
   <g clip-path={`url(#${id}-clip-${index})`}><path class="inoe-wordmark-fold" d={glyph.fold} fill={`url(#${id}-fold)`}/><path class="inoe-wordmark-edge" d={glyph.edge} fill="none" stroke-width=".7"/></g>
  </svg>
 </span>)}
</span>
