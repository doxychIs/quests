---
import {href} from '../../lib/data';
import '../../styles/inner.css';
---
<div class="game-shell detective-game" data-game="detective">
 <div class="game-toolbar"><span class="eyebrow">ДЕЛО <b>№ 041 / РАБОЧИЙ СТОЛ</b></span><span data-status role="status" aria-live="polite">Найдите латунный ключ с полумесяцем на головке.</span><button class="text-link" data-desk-reset>Другая раскладка ↺</button></div>
 <div class="desk-viewport" tabindex="0" aria-label="Стол с предметами. При увеличении прокручивайте его; Tab перебирает предметы.">
 <svg class="desk-scene" viewBox="0 0 1000 580" xmlns="http://www.w3.org/2000/svg" role="group" aria-label="Архивный стол с пятнадцатью предметами">
  <defs><linearGradient id="desk-wood" x2="0" y2="1"><stop stop-color="#655344"/><stop offset="1" stop-color="#8a7151"/></linearGradient><linearGradient id="desk-paper" x2="1" y2="1"><stop stop-color="#e3d5ae"/><stop offset="1" stop-color="#b5a681"/></linearGradient><linearGradient id="desk-brass"><stop stop-color="#d0b776"/><stop offset=".5" stop-color="#8c723b"/><stop offset="1" stop-color="#e2c88a"/></linearGradient><linearGradient id="desk-metal"><stop stop-color="#666d64"/><stop offset=".5" stop-color="#c1c7b5"/><stop offset="1" stop-color="#616b60"/></linearGradient><radialGradient id="lamp-light"><stop stop-color="#f8e2a650"/><stop offset="1" stop-color="#f8e2a600"/></radialGradient><filter id="desk-shadow" x="-40%" y="-40%" width="180%" height="190%"><feDropShadow dx="5" dy="10" stdDeviation="5" flood-color="#1d2517" flood-opacity=".4"/></filter><filter id="paper-grain"><feTurbulence type="fractalNoise" baseFrequency=".6" numOctaves="2" seed="8" result="noise"/><feColorMatrix in="noise" type="saturate" values="0"/><feBlend in="SourceGraphic" mode="multiply"/></filter><pattern id="desk-lines" width="1000" height="80" patternUnits="userSpaceOnUse"><path d="M0 0h1000M0 2h1000M0 79h1000" stroke="#322d2240"/><path d="M0 18q200 10 400 0t600 5M0 47q100 9 400 0t600 0" fill="none" stroke="#bca17a25"/></pattern></defs>
  <g id="desk-art"><rect width="1000" height="580" fill="url(#desk-wood)"/><rect width="1000" height="580" fill="url(#desk-lines)"/><ellipse cx="220" cy="160" rx="400" ry="320" fill="url(#lamp-light)"/>
  <g class="desk-object" data-item="ledger" transform="translate(355 130) rotate(-8)" role="button" tabindex="0" aria-label="Открытая книга учёта"><g filter="url(#desk-shadow)"><path d="M-8-8H216V177H-8Z" fill="#353b2a"/><path d="M0 0q45-10 100 0V160q-52-8-100 0z" fill="url(#desk-paper)"/><path d="M100 0q52-8 108 0v160q-57-8-108 0z" fill="#c5b893"/><path d="M100 0v160" stroke="#736748" stroke-width="3"/>{Array.from({length:11},(_,i)=><path d={`M10 ${18+i*12}h77m23 0h85`} stroke="#827b5b" stroke-width="1" opacity=".5"/>)}<path d="M45 2v156M155 4v153" stroke="#9e654b" opacity=".5"/><path d="M94 0v140l6-8 7 8V0" fill="#915d44"/></g></g>
  <g class="desk-object" data-item="lamp" transform="translate(130 80) rotate(-6)" role="button" tabindex="0" aria-label="Настольная лампа"><g filter="url(#desk-shadow)"><ellipse cy="106" rx="53" ry="18" fill="#394332" stroke="#958b5a" stroke-width="3"/><path d="M0 100V10q0-30 20-36" fill="none" stroke="url(#desk-brass)" stroke-width="9"/><path d="M-57-28q15-45 65-40 45 5 61 49z" fill="#384b37" stroke="#a09d70" stroke-width="3"/><ellipse cx="6" cy="-22" rx="62" ry="10" fill="#c5c2a1"/><ellipse cx="6" cy="-22" rx="35" ry="6" fill="#e7d89c"/><path d="m-22 120-20 30-80 10" fill="none" stroke="#20281d" stroke-width="4"/></g></g>
  <g class="desk-object" data-item="envelope" transform="translate(690 190) rotate(13)" role="button" tabindex="0" aria-label="Почтовый конверт с сургучом"><g filter="url(#desk-shadow)"><rect x="-85" y="-50" width="170" height="100" fill="url(#desk-paper)" stroke="#8d7d57"/><path d="m-85-50 85 62 85-62M-85 50l60-40M85 50 25 10" fill="none" stroke="#9c8c66"/><circle cy="10" r="14" fill="#7a4e3c"/><path d="m-4 5 9 10M5 5l-9 10" stroke="#b27c56" stroke-width="2"/><rect x="50" y="-38" width="22" height="24" fill="#6c7b61" stroke="#b4b996" stroke-dasharray="2"/></g></g>
  <g class="desk-object" data-item="watch" transform="translate(820 370) rotate(-15)" role="button" tabindex="0" aria-label="Карманные часы"><g filter="url(#desk-shadow)"><path d="M0-50q10-35 40-30t30-22" stroke="url(#desk-brass)" stroke-width="4" stroke-dasharray="4 3" fill="none"/><circle cy="-46" r="8" stroke="#bca576" stroke-width="4" fill="none"/><circle r="45" fill="url(#desk-brass)"/><circle r="37" fill="#d8d3b5" stroke="#72633f" stroke-width="2"/>{Array.from({length:12},(_,i)=><path transform={`rotate(${i*30})`} d="M0-31v5" stroke="#505742" stroke-width="2"/>)}<path d="M0-24v24l19 8" fill="none" stroke="#36402e" stroke-width="3"/><circle r="3" fill="#36402e"/></g></g>
  <g class="desk-object" data-item="target" transform="translate(615 425) rotate(-12)" role="button" tabindex="0" aria-label="Латунный ключ с полумесяцем на головке"><g filter="url(#desk-shadow)"><path d="M-18-13a18 18 0 1 0 0 26 15 15 0 1 1 0-26" fill="url(#desk-brass)" stroke="#5f512e" stroke-width="1.4"/><path d="M-6-2h65v8H42v11H31V7H-6" fill="url(#desk-brass)" stroke="#5f512e" stroke-width="1.5"/><path d="M-3 0h59" stroke="#dac390" stroke-width="2"/></g></g>
  <g class="desk-object" data-item="key" transform="translate(250 395) rotate(28)" role="button" tabindex="0" aria-label="Серебристый ключ с круглой головкой"><g filter="url(#desk-shadow)"><circle cx="-15" r="15" fill="none" stroke="url(#desk-metal)" stroke-width="7"/><path d="M0 0h58v10H46v7H35V5H0" fill="url(#desk-metal)" stroke="#4e5a4a" stroke-width="1"/></g></g>
  <g class="desk-object" data-item="scissors" transform="translate(690 85) rotate(-32)" role="button" tabindex="0" aria-label="Ножницы"><g filter="url(#desk-shadow)"><ellipse cx="-12" cy="38" rx="11" ry="22" fill="none" stroke="#3c4837" stroke-width="7"/><ellipse cx="18" cy="38" rx="11" ry="22" fill="none" stroke="#3c4837" stroke-width="7"/><path d="m-12 18 35-78-15 80M18 18-17-60l10 80" fill="url(#desk-metal)" stroke="#535e4d"/><circle cy="9" r="4" fill="#a69c76"/></g></g>
  <g class="desk-object" data-item="cup" transform="translate(870 120) rotate(9)" role="button" tabindex="0" aria-label="Фарфоровая чашка с чаем"><g filter="url(#desk-shadow)"><ellipse rx="59" ry="49" fill="#c8ccb5" stroke="#e5e4ce" stroke-width="4"/><path d="M40-13q44-8 24 24H43" fill="none" stroke="#c7ccb6" stroke-width="10"/><circle r="38" fill="#e7e3cd"/><circle r="31" fill="#715738"/><path d="M-22-13q13-12 26-11" stroke="#d4b876" stroke-width="3" fill="none" opacity=".5"/></g></g>
  <g class="desk-object" data-item="photos" transform="translate(110 320) rotate(-14)" role="button" tabindex="0" aria-label="Две старые фотографии"><g filter="url(#desk-shadow)"><rect x="-55" y="-60" width="128" height="155" fill="#d4cbb2" transform="rotate(12)"/><rect x="-62" y="-65" width="125" height="150" fill="#ddd6bd"/><rect x="-52" y="-55" width="105" height="113" fill="#8a8d78"/><path d="M-52 58V8l30-45 32 20L53-5v63" fill="#575e4e"/><path d="M-28 58v-74h26v74M6 58V-5h35v63" fill="#6e7560"/><path d="M-22-5h12m-12 14h12M14 9h18M14 23h18" stroke="#a3a78b" stroke-width="6"/><path d="M-45 71h70" stroke="#999781" stroke-width="2"/></g></g>
  <g class="desk-object" data-item="pen" transform="translate(430 380) rotate(22)" role="button" tabindex="0" aria-label="Перьевая ручка"><g filter="url(#desk-shadow)"><rect x="-80" y="-5" width="135" height="10" rx="5" fill="#272f25"/><path d="M55-5 78 0 55 5Z" fill="url(#desk-brass)"/><path d="M-70-6h35" stroke="#c5b17c" stroke-width="3"/><path d="M-80-4h3v8h-3" fill="#b1a071"/></g></g>
  <g class="desk-object" data-item="ink" transform="translate(580 75) rotate(10)" role="button" tabindex="0" aria-label="Чернильница"><g filter="url(#desk-shadow)"><path d="M-25-22h50l8 55h-66z" fill="#273a30" stroke="#87957a" stroke-width="2"/><rect x="-18" y="-39" width="36" height="18" rx="2" fill="#444c35"/><rect x="-22" y="-2" width="44" height="24" fill="#b4b398"/><path d="M-14 8h25m-25 6h18" stroke="#5e6b4f" stroke-width="2"/></g></g>
  <g class="desk-object" data-item="glasses" transform="translate(438 480) rotate(-8)" role="button" tabindex="0" aria-label="Очки в тонкой оправе"><g filter="url(#desk-shadow)" fill="none" stroke="url(#desk-brass)" stroke-width="3"><circle cx="-28" r="23"/><circle cx="29" r="23"/><path d="M-6 0q6-10 12 0M-50-3l-18-40M51-3l17-40"/><path d="m-42-10 14-8M15-10l15-8" stroke="#d9debf" opacity=".5"/></g></g>
  <g class="desk-object" data-item="ruler" transform="translate(610 515) rotate(3)" role="button" tabindex="0" aria-label="Деревянная линейка"><g filter="url(#desk-shadow)"><rect x="-110" y="-13" width="240" height="28" fill="#ae9565" stroke="#726442"/>{Array.from({length:25},(_,i)=><path d={`M${-105+i*9} -13v${i%5===0?13:7}`} stroke="#514f38" stroke-width="1"/>)}<circle cx="116" r="3" fill="#5d5d41"/></g></g>
  <g class="desk-object" data-item="stamp" transform="translate(890 490) rotate(15)" role="button" tabindex="0" aria-label="Печать с деревянной ручкой"><g filter="url(#desk-shadow)"><ellipse cy="13" rx="29" ry="17" fill="#343d2d"/><path d="M-19 10v-12q13-9 8-35-7-20 11-22 18 2 11 22Q7-11 19-2v12" fill="#735c3c" stroke="#a39062" stroke-width="2"/><ellipse cy="11" rx="24" ry="10" fill="#4b5238" opacity=".7"/></g></g>
  <g class="desk-object" data-item="coins" transform="translate(340 70) rotate(14)" role="button" tabindex="0" aria-label="Три старые монеты"><g filter="url(#desk-shadow)"><circle r="17" fill="url(#desk-brass)" stroke="#605b38"/><circle cx="28" cy="5" r="19" fill="url(#desk-brass)" stroke="#605b38"/><circle cx="8" cy="22" r="18" fill="url(#desk-brass)" stroke="#605b38"/><circle cx="8" cy="22" r="13" fill="none" stroke="#8c7c4a"/><path d="M8 14v15m-4-12 4-3" stroke="#807446" stroke-width="2"/></g></g>
  <rect x="3" y="3" width="994" height="574" fill="none" stroke="#292d1c" stroke-width="6"/>
  </g>
 </svg>
 <div class="desk-loupe" aria-hidden="true"><svg viewBox="0 0 200 200"><use href="#desk-art"/></svg></div>
 </div>
 <div class="game-under"><p>Улика: латунный ключ с полумесяцем вместо круглой головки. Серебристый ключ здесь ни при чём.</p><button class="button" data-desk-hint>Взять подсказку <span data-hint-count>0/3</span></button></div><div class="desk-actions"><div class="zoom-controls"><button data-zoom="-1" aria-label="Уменьшить сцену">−</button><span data-zoom-label>100%</span><button data-zoom="1" aria-label="Увеличить сцену">+</button></div><button class="text-link" data-loupe aria-pressed="false">Лупа: выкл.</button><span>На телефоне увеличьте сцену и листайте её пальцем.</span></div><p class="desk-hint" data-hint-text aria-live="polite"></p>
 <div class="game-result" hidden tabindex="-1"><span class="eyebrow">ЗАПИСЬ № 041</span><h3>Ключ — от почтового ящика.</h3><p>На его головке вырезан полумесяц. Такой же знак стоит на последнем конверте. Письмо ещё не было отправлено.</p><a class="button" href={href('arhiv/quests/poslednee-pismo/')}>Открыть «Последнее письмо» ↗</a><button class="text-link" data-replay>Исследовать другой стол ↺</button></div>
</div>
