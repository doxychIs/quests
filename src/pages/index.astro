---
import Base from '../layouts/Base.astro';
import BrandWordmark from '../components/BrandWordmark.astro';
import {worlds,href,worldKeys} from '../lib/data';
import '../styles/hub.css';
const previewNames={iznanka:'ИЗНАНКА',arhiv:'Архив',ostrov:'Остров'};
---
<Base>
 <script is:inline>
  document.documentElement.classList.add('hub-hand-enhanced');
  setTimeout(()=>{const hero=document.querySelector('[data-hub-hero]');if(hero&&!hero.hasAttribute('data-logo-ready'))document.documentElement.classList.remove('hub-hand-enhanced')},15000);
 </script>
 <section class="hub-intro" data-hub-hero aria-labelledby="hub-title">
  <div class="hub-hand-stage" data-hand-stage>
  <div class="hub-hand-scene" data-hand-scene data-hand-src={href('models/inoe-hand-animated.glb')} aria-hidden="true"></div>
  </div>
  <h1 id="hub-title" class="hub-logo-home" aria-label="ИНОЕ"><span class="hub-logo-placeholder" aria-hidden="true"><BrandWordmark id="hero-metric"/></span><a class="hub-logo-object" data-hub-logo href={href()} aria-label="ИНОЕ — главная"><BrandWordmark id="hero-wordmark" animated/></a></h1>
 </section>
 <section class="hub-worlds" id="worlds" data-world-selector aria-label="Выбрать мир квестов">
  <div class="hub-worlds-heading"><p class="brand-kicker">По ту сторону обычного</p><h2>Три мира.<br/><em>Одна грань.</em></h2><p class="hub-worlds-note">Выберите свою историю.</p></div>
  <nav class="hub-world-list" aria-label="Три мира квестов">
   {worldKeys.map(w=><a class={`hub-world hub-world-${w}`} href={href(w+'/')} data-world-zone={w} aria-label={`${previewNames[w]} — открыть квесты`}>
    <span class="hub-world-cover" aria-hidden="true">{worlds[w].name}</span>
    <span class="hub-world-preview" aria-hidden="true">
     {w==='arhiv'?<><img class="hub-preview-paper" src={href('assets/archive-paper.webp')} alt="" width="1440" height="1024" loading="lazy"/><img class="hub-preview-library" src={href('assets/archive-hero-poster.webp')} alt="" width="1280" height="720" loading="lazy"/></>:<img class="hub-preview-scene" src={href(w==='iznanka'?'assets/hub-preview-iznanka.png':'assets/island-hero-poster.webp')} alt="" width={w==='iznanka'?1265:1280} height={w==='iznanka'?712:720} loading="lazy"/>}
     <span class="hub-world-preview-title">{previewNames[w]}</span>
    </span>
   </a>)}
  </nav>
 </section>
 <section class="hub-about" id="how" aria-labelledby="about-title">
  <h2 id="about-title">Вы — часть<br/>происходящего.</h2>
  <div><p>«ИНОЕ» объединяет хоррор, детективы и семейные приключения. Исследуйте комнаты, находите связи и принимайте решения вместе с командой.</p><p>У каждого квеста указаны возраст, длительность и состав команды. Специальные знания не нужны.</p><a class="hub-link" href={href('about/')}>О проекте</a></div>
 </section>
 <section class="hub-gift-simple" aria-labelledby="gift-title"><div><p class="hub-location">Для тех, с кем хочется разделить впечатления</p><h2 id="gift-title">Подарить<br/>приключение.</h2></div><div><p>Выберите мир, добавьте имя и несколько своих слов. Приглашение можно сохранить и отправить.</p><a class="hub-action" href={href('certificates/')}>Создать приглашение</a></div></section>
 <section class="hub-questions" aria-labelledby="questions-title"><h2 id="questions-title">Перед игрой.</h2><div>
  <details><summary>Сколько человек в команде?</summary><p>От двух до шести. Точный состав зависит от квеста и указан в его описании.</p></details>
  <details><summary>Можно с детьми?</summary><p>Для семейных команд есть «Остров», от 6 лет. «Архив» — от 14 лет, отдельные квесты от 16. «Изнанка» — только 18+.</p></details>
  <details><summary>Можно забронировать игру?</summary><p>Сейчас это демонстрационный проект: можно изучить квесты и проверить форму записи. Реальные сеансы и оплата пока не подключены.</p></details>
 </div></section>
 <script>import {initWorldSelector} from '../scripts/world-selector';import {initHubHero} from '../scripts/hub-hero';initWorldSelector();initHubHero();</script>
</Base>
