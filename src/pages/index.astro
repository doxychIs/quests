---
import Base from '../layouts/Base.astro';
import {worlds,href,worldKeys,quests} from '../lib/data';
import '../styles/hub.css';
const descriptions={iznanka:'Для тех, кто хочет почувствовать больше.',arhiv:'Для тех, кто замечает больше остальных.',ostrov:'Для маленьких исследователей и их взрослых.'};
const genres={iznanka:'Хоррор и перформанс',arhiv:'Детективы и загадки',ostrov:'Семейные приключения'};
---
<Base>
 <section class="hub-intro" aria-labelledby="hub-title">
  <p class="hub-location">Квесты в реальности · Пермь</p>
  <h1 id="hub-title">Выйти из<br/>обычного.</h1>
  <div class="hub-intro-bottom"><p>Одна команда. Час внутри другой реальности.<br/> Выберите, какой будет ваша.</p><a class="hub-action" href="#worlds">Выбрать квест</a></div>
 </section>
 <section class="hub-worlds" id="worlds" data-world-selector data-active-world="arhiv" aria-labelledby="worlds-title">
  <div class="hub-section-heading"><h2 id="worlds-title">Три настроения.</h2><p data-selector-caption>{descriptions.arhiv}</p></div>
  <nav class="hub-world-list" aria-label="Три мира квестов">
   {worldKeys.map(w=><a class={`hub-world hub-world-${w}`} href={href(w+'/')} data-world-zone={w} data-world-caption={descriptions[w]}>
    <span class="hub-world-meta">{genres[w]}<span>{worlds[w].age}</span></span>
    <h3>{worlds[w].name}</h3>
    <p>{w==='iznanka'?'Заброшенная палата. Четыре квеста. То, что остаётся за кадром.':w==='arhiv'?'Чужие письма, незаконченные дела и детали, которые всё меняют.':'Приключения для детей и взрослых. Загадки проще решать вместе.'}</p>
    <span class="hub-world-bottom">{quests.filter(q=>q.world===w).length} квеста<span>Открыть</span></span>
   </a>)}
  </nav>
 </section>
 <section class="hub-about" id="how" aria-labelledby="about-title">
  <h2 id="about-title">Вы — часть<br/>происходящего.</h2>
  <div><p>«ИНОЕ» объединяет хоррор, детективы и семейные приключения. Исследуйте комнаты, находите связи и принимайте решения вместе с командой.</p><p>У каждого квеста указаны возраст, длительность и состав команды. Специальные знания не нужны.</p><a class="hub-link" href={href('about/')}>О проекте</a></div>
 </section>
 <section class="hub-gift-simple" aria-labelledby="gift-title"><div><p class="hub-location">Для тех, с кем хочется разделить впечатления</p><h2 id="gift-title">Подарить<br/>приключение.</h2></div><div><p>Выберите мир, добавьте имя и несколько своих слов. Приглашение можно сохранить и отправить.</p><a class="hub-action" href={href('certificates/')}>Создать приглашение</a></div></section>
 <section class="hub-questions" aria-labelledby="questions-title"><h2 id="questions-title">Перед игрой.</h2><div>
  <details><summary>Сколько человек в команде?</summary><p>От двух до шести. Точный состав зависит от квеста и указан в его описании.</p></details>
  <details><summary>Можно с детьми?</summary><p>Для семейных команд есть «Остров», от 6 лет. «Архив» — от 14 лет, отдельные квесты от 16. «Изнанка» — только 18+.</p></details>
  <details><summary>Можно забронировать игру?</summary><p>Сейчас это демонстрационный проект: можно изучить квесты и проверить форму записи. Реальные сеансы и оплата пока не подключены.</p></details>
 </div></section>
 <script>import {initWorldSelector} from '../scripts/world-selector';initWorldSelector();</script>
</Base>
