---
import Base from '../layouts/Base.astro';
import {worlds,href,asset,worldKeys,quests} from '../lib/data';
import '../styles/hub.css';
const descriptions={iznanka:'Для тех, кто хочет почувствовать больше.',arhiv:'Для тех, кто замечает больше остальных.',ostrov:'Для маленьких исследователей и их взрослых.'};
---
<Base>
 <section class="world-selector" id="worlds" data-world-selector data-active-world="arhiv" aria-labelledby="portal-title">
  <div class="portal-hero-copy"><p class="portal-kicker"><span class="portal-spark" aria-hidden="true">✳</span> Квесты в реальности / Пермь</p><h1 id="portal-title">По ту <br/>сторону <br/><em>обычного.</em></h1><p class="portal-hero-intro">Выйдите из привычного.<br/>Здесь вы — часть истории.</p><a class="portal-underlink" href="#how">Первые шаги в неизвестное <span aria-hidden="true">↓</span></a><div class="selector-notice"><span aria-hidden="true"></span><p data-selector-caption>{descriptions.arhiv}</p></div></div>
  <nav class="world-zones" aria-label="Три мира квестов">
   {worldKeys.map((w,i)=><a class:list={['world-zone',`zone-${w}`,{'is-current':w==='arhiv'}]} href={href(w+'/')} data-world-zone={w} data-world-caption={descriptions[w]} aria-label={`Войти в мир «${worlds[w].name}»`}>
    <span class="portal-door-top"><span>0{i+1} / {worlds[w].subtitle}</span><span>{worlds[w].age}</span></span>
    <span class="portal-door"><span class:list={['selector-scene',`scene-${w}`,{'is-current':w==='arhiv'}]} data-scene={w}>
     {w==='iznanka'?<><span class="closed-threshold" aria-hidden="true"><span class="threshold-light"></span><i></i></span><img data-safe-src={asset('iznanka')} class="adult-preview" alt="" width="1536" height="1024"/></>:<img src={asset(w==='arhiv'?'archive-hero-poster':'island-hero-poster')} alt="" width="1280" height="720" fetchpriority={w==='arhiv'?'high':'auto'}/>}
     {w==='ostrov'&&<video data-hub-film data-src={href('assets/sea-film.mp4')} data-src-mobile={href('assets/sea-film-mobile.mp4')} muted loop playsinline preload="none" aria-hidden="true"/>}
    </span><span class="portal-door-handle" aria-hidden="true">↗</span><span class="portal-door-note">{w==='iznanka'?'Заходите, если решитесь.':w==='arhiv'?'Каждая деталь — улика.':'Приключения любят компанию.'}</span></span>
    <span class="zone-caption"><span class="zone-name">{worlds[w].name}</span><span class="zone-enter" aria-hidden="true">↗</span></span><span class="zone-genre">{quests.filter(q=>q.world===w).length} истории · {w==='iznanka'?'хоррор и перформанс':w==='arhiv'?'детективы и загадки':'семейные приключения'}</span>
   </a>)}
  </nav>
  <div class="portal-hero-bottom"><span>Три мира. Двенадцать историй. Одна ваша.</span><span>Листайте с любопытством ↓</span></div>
 </section>
 <section class="hub-editorial portal-section" id="how"><div class="portal-section-heading"><span class="portal-kicker">01 / Правила хорошей истории</span><h2>Не наблюдать.<br/><em>Участвовать.</em></h2></div><div class="hub-editorial-copy"><p>Обычный вечер можно провести по привычке. А можно открыть дверь, собрать команду и оказаться там, где от ваших решений зависит финал.</p><p>Замечайте странности. Соединяйте подсказки. Спорьте, пробуйте, находите ответы вместе.</p><dl class="hub-facts"><div><dt>12</dt><dd>разных историй</dd></div><div><dt>2–6</dt><dd>человек в команде</dd></div><div><dt>60–75</dt><dd>минут внутри квеста</dd></div></dl><a class="portal-underlink" href={href('about/')}>Как всё устроено <span aria-hidden="true">↗</span></a></div></section>
 <section class="hub-route portal-section"><div class="portal-section-heading"><span class="portal-kicker">02 / Ваш маршрут</span><h2>До приключения —<br/><em>три шага.</em></h2></div><ol class="portal-steps"><li><span>01</span><h3>Поймайте настроение</h3><p>Тревожный сигнал, забытая рукопись или зов приключений. Выберите мир, который откликается.</p></li><li><span>02</span><h3>Соберите своих</h3><p>Друзья, семья, коллеги. Возраст и состав команды указаны в описании каждого квеста.</p></li><li><span>03</span><h3>Откройте историю</h3><p>Загляните в квест, узнайте его правила и попробуйте небольшое испытание на странице мира.</p></li></ol></section>
 <section class="hub-gift portal-section"><div class="hub-gift-copy"><span class="portal-kicker">03 / Для того самого человека</span><h2>Вместо вещи —<br/><em>целая история.</em></h2><p>Имя, несколько тёплых слов и мир на выбор. Соберите личное приглашение тому, с кем хочется разделить приключение.</p><a class="portal-button" href={href('certificates/')}>Создать приглашение <span aria-hidden="true">↗</span></a><small>Можно сохранить открытку. Покупка не требуется.</small></div><a class="hub-ticket" href={href('certificates/')} aria-label="Оформить подарочное приглашение"><div><span class="ticket-wordmark">ИНОЕ</span><span class="ticket-overline">Личное приглашение</span><p>Тому, кто<br/><em>любит истории.</em></p><span class="ticket-worlds">Изнанка / Архив / Остров</span><span class="ticket-fine">Самое интересное — по ту сторону.</span></div><span class="ticket-stub" aria-hidden="true"><i>Одна дверь.<br/>Новая история.</i><b>↗</b><span>ИНОЕ</span></span></a></section>
 <section class="hub-practical portal-section"><div><span class="portal-kicker">04 / Между делом</span><h2>Любопытство —<br/><em>уже начало.</em></h2><a class="portal-underlink" href={href('rules/')}>Все правила участия <span aria-hidden="true">↗</span></a></div><div class="portal-faq"><details><summary>Нужен опыт прохождения квестов?<span aria-hidden="true">+</span></summary><p>Специальные знания не нужны. В описании истории есть её сложность, возраст и правила — начните с того, что вам интересно.</p></details><details><summary>Можно исследовать сайт с детьми?<span aria-hidden="true">+</span></summary><p>Для семейного приключения выбирайте «Остров». «Изнанка» открывается только после подтверждения 18+. Звук и неожиданные моменты включаются отдельно.</p></details><details><summary>Здесь уже можно забронировать игру?<span aria-hidden="true">+</span></summary><p>Пока это концептуальный проект. Можно выбрать историю, пройти испытания и проверить форму записи. Реальная площадка, бронирование и оплата ещё не подключены.</p></details></div></section>
 <script>import {initWorldSelector} from '../scripts/world-selector';initWorldSelector();</script>
</Base>
