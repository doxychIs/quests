---
import Base from '../layouts/Base.astro';
import {href,asset,worlds,worldKeys} from '../lib/data';
import {config} from '../lib/config';
import '../styles/inner.css';
export function getStaticPaths(){return ['about','contacts','certificates','rules','privacy'].map(page=>({params:{page}}))}
const page=Astro.params.page! as 'about'|'contacts'|'certificates'|'rules'|'privacy';
const meta={
 about:{title:'Одна команда. Три разных мира.',first:'Одна команда.',second:'Три разных мира.',label:'О проекте',number:'01',intro:'«ИНОЕ» — место для историй, в которых хочется оказаться. И для тех, с кем хочется их разделить.'},
 certificates:{title:'Подарите новую историю.',first:'Подарите',second:'новую историю.',label:'Подарочные приглашения',number:'02',intro:'Несколько ваших слов, имя того самого человека и целый мир впереди. Подарок начинается с приглашения.'},
 contacts:{title:'По ту сторону — Пермь.',first:'По ту сторону —',second:'Пермь.',label:'Контакты',number:'03',intro:'Приключениям нужно место встречи. Наше — в городе, где легко свернуть с привычного маршрута.'},
 rules:{title:'До того, как откроется дверь.',first:'До того, как',second:'откроется дверь.',label:'Правила участия',number:'04',intro:'Немного ясности перед неизвестностью. Собрали важное, чтобы вы могли сосредоточиться на истории.'},
 privacy:{title:'Личное остаётся личным.',first:'Личное остаётся',second:'личным.',label:'Конфиденциальность',number:'05',intro:'Что сайт запоминает, как работают формы и где хранятся настройки. Без мелкого шрифта.'}
};
const item=meta[page];
const legalSections=page==='rules'?[
 {id:'age',title:'Возраст и команда',text:'У каждого квеста указаны возраст, длительность и число игроков. «Изнанка» предназначена только для совершеннолетних. В семейных сценариях детям до 12 лет нужен сопровождающий взрослый. В «Архиве» ограничения зависят от квеста.'},
 {id:'comfort',title:'Комфорт важнее финала',text:'В концепции предусмотрены подсказки и возможность остановить игру. Не применяйте силу к механизмам. Контакт с актёрами, если он появится на реальной площадке, согласовывается отдельно.'},
 {id:'preferences',title:'Настройки впечатлений',text:'Звук выключен до вашего выбора. Неожиданные моменты в хоррор-испытании требуют отдельного согласия. Стробоскопы не используются. Уменьшить движение можно в настройках сайта или операционной системы.'},
 {id:'booking',title:'Демонстрационная запись',text:'Выбор даты и времени проверяет интерфейс. Он не создаёт реальную бронь, не закрепляет сеанс и не принимает оплату. Все сценарии, декорации и организационные сведения описывают концепцию будущего проекта.'}
]:page==='privacy'?[
 {id:'storage',title:'Что остаётся в браузере',text:'Сайт хранит настройки уменьшенного движения и звука в localStorage. Подтверждение возраста и разрешение неожиданных моментов хранятся в sessionStorage до завершения сеанса браузера. Сброс доступен через кнопку настроек.'},
 {id:'forms',title:'Форма записи',text:'Имя, телефон и комментарий используются только для локального показа результата. Сайт не отправляет их на сервер и не сохраняет в браузерном хранилище. После перезагрузки страницы эти данные исчезнут. Восстановление полей самим браузером зависит от его настроек.'},
 {id:'invitation',title:'Подарочное приглашение',text:'Имя и пожелание обрабатываются в текущей вкладке. При нажатии «Сохранить» создаётся локальная SVG-открытка. Данные не передаются третьим лицам.'},
 {id:'services',title:'Внешние сервисы',text:'На сайте нет аналитики, рекламных трекеров, внешних шрифтов или видеовставок. Медиа загружаются вместе с сайтом. Если вы откроете внешнюю ссылку, начнут действовать правила соответствующего сервиса.'},
 {id:'launch',title:'Перед реальным запуском',text:'Владелец площадки должен указать сведения об операторе данных, правовые основания и сроки хранения. Настоящая система бронирования потребует отдельной политики.'}
]:[];
---
<Base title={`${item.title} — ИНОЕ`} page={page}>
 <section class="common-page section-pad"><a href={href()} class="detail-back">← К трём мирам</a><div class="page-issue"><span>ИНОЕ / {item.label}</span><span>Глава {item.number}</span></div><h1>{item.first}<br/><em>{item.second}</em></h1><p class="page-intro">{item.intro}</p>
 {page==='about'&&<><div class="portal-about"><div><p class="large-copy">Быть рядом.<br/>Замечать больше.<br/><em>Действовать вместе.</em></p><figure class="about-image"><img src={asset('archive-hero-poster')} width="1280" height="720" alt="Книги, раскрытая рукопись и мягкий свет в библиотеке Архива" loading="lazy"/><figcaption>Одна из историй начинается здесь.</figcaption></figure></div><div class="portal-about-copy"><p>«ИНОЕ» — концептуальный квест-центр в Перми. «Изнанка» исследует чувство неизвестности, «Архив» предлагает замедлиться и замечать, «Остров» собирает семью в приключение.</p><p>Все двенадцать квестов вымышлены. Изображения — авторские художественные сцены, а не фотографии действующей площадки. Мы не приписываем проекту реальные отзывы или опыт проведения игр.</p><p>Сайт можно исследовать полностью: выбрать квест, пройти испытания, проверить запись и создать подарочное приглашение. Реальная площадка и оплата пока не подключены.</p><a class="portal-underlink" href={href()+'#worlds'}>Найти свой мир <span aria-hidden="true">↗</span></a></div></div><section class="about-steps" aria-labelledby="about-steps-title"><span class="portal-kicker">Сначала — любопытство</span><h2 id="about-steps-title">У каждой команды<br/><em>свой способ войти.</em></h2><ol class="portal-steps"><li><span>01</span><h3>Выберите настроение</h3><p>От интеллектуального напряжения до приключения с детьми. У каждого мира — свой характер.</p></li><li><span>02</span><h3>Возьмите своих</h3><p>Не нужны специальные знания — только внимание, любопытство и люди, с которыми интересно.</p></li><li><span>03</span><h3>Настройте свой темп</h3><p>Звук, движение и неожиданные моменты включаются по вашему выбору.</p></li></ol><a href={href()+'#worlds'} class="portal-button">Выбрать мир <span aria-hidden="true">↗</span></a></section></>}
 {page==='contacts'&&<><div class="contacts-layout"><div><p class="large-copy">Хорошее место<br/><em>для новых историй.</em></p><p>Это демонстрационный проект. Реальные контакты и адрес квест-центра ещё не добавлены.</p><dl class="contact-list"><div><dt>Город</dt><dd>Пермь</dd></div><div><dt>Адрес</dt><dd>{config.address||'Будет указан после подключения площадки'}</dd></div><div><dt>Телефон</dt><dd>{config.phone?<a href={'tel:'+config.phone}>{config.phone}</a>:'Пока не указан'}</dd></div><div><dt>Почта</dt><dd>{config.email?<a href={'mailto:'+config.email}>{config.email}</a>:'Пока не указана'}</dd></div><div><dt>Местное время</dt><dd>Пермь · UTC+5</dd></div></dl><a href={href('about/')} class="portal-underlink">Познакомиться с проектом <span aria-hidden="true">↗</span></a></div><div class="contact-art" aria-hidden="true"><span>Точка на карте. Начало истории.</span><svg viewBox="0 0 300 380"><path d="M20 345V110H96V345M112 345V88a38 38 0 0 1 76 0v257M204 345V140a38 38 0 0 1 76 0v205M10 345H290M30 335V120H87V335M122 335V90a28 28 0 0 1 56 0v245M214 335V140a28 28 0 0 1 56 0v195M76 225h7m85 0h7m85 0h7M150 15v20m-10-10h20"/></svg><p>Три двери.<br/><em>Один город.</em></p><small>ПЕРМЬ / 58°00′ С. Ш. · 56°15′ В. Д.</small></div></div><div class="contact-help"><p>Пока можно выбрать историю и отправиться на разведку.</p><a class="portal-button" href={href()+'#worlds'}>К трём мирам <span aria-hidden="true">↗</span></a></div></>}
 {page==='certificates'&&<div class="certificate-layout"><div class="certificate-preview" data-certificate><div class="certificate-preview-label"><span>Так выглядит ваше приглашение</span><span>↙</span></div><div class="certificate-frame"><span class="certificate-brand">ИНОЕ</span><span class="eyebrow">Личное приглашение на квест</span><h2>Для <span data-recipient>вас</span>.</h2><p data-gift-world>Три мира на выбор</p><i data-gift-message>Пусть этот день станет приключением.</i><small>Демонстрационное приглашение.<br/>Не является оплаченным сертификатом.</small><span class="certificate-stub" aria-hidden="true"><span>По ту сторону обычного</span><svg viewBox="0 0 60 100"><path d="M3 97V30h15v67M23 97V13a8 8 0 0 1 16 0v84M44 97V48a7 7 0 0 1 14 0v49M0 97h60"/></svg><b>↗</b></span></div><p class="certificate-preview-note">Имя и пожелание появятся на открытке сразу. Сохраните её и отправьте человеку, с которым хочется разделить историю.</p></div><form id="gift-form"><span class="eyebrow">01 / Сделайте его личным</span><p>Выберите мир, укажите имя и добавьте пару тёплых слов.</p><label class="field">Для кого <input name="recipient" maxlength="30" placeholder="Имя получателя" autocomplete="off"/></label><label class="field">В какой мир приглашаем <select name="world"><option value="all">Три мира на выбор</option>{worldKeys.map(w=><option value={w}>{worlds[w].name} / {worlds[w].age}</option>)}</select></label><label class="field">Ваши слова <textarea name="message" maxlength="120" rows="3" placeholder="Пусть этот день станет приключением."></textarea></label><button type="submit" class="portal-button">Сохранить приглашение <span aria-hidden="true">↓</span></button><span id="gift-status" role="status" aria-live="polite"></span><p class="gift-privacy-note">Имя и пожелание остаются в этой вкладке. <a href={href('privacy/')}>Подробнее о данных ↗</a></p></form></div>}
 {(page==='rules'||page==='privacy')&&<div class="legal-layout"><nav class="legal-navigation" aria-label="Содержание страницы"><span>В ЭТОЙ ГЛАВЕ</span>{legalSections.map((s,i)=><a href={'#'+s.id}><span>0{i+1}</span>{s.title}</a>)}</nav><div class="legal-copy">{legalSections.map(s=><section class="legal-section" id={s.id}><h2>{s.title}</h2><p>{s.text}</p></section>)}{page==='rules'?<a href={href()+'#worlds'} class="portal-button">К выбору мира <span aria-hidden="true">↗</span></a>:<><button class="text-link" data-clear-storage>Сбросить локальные настройки</button><p id="storage-status" role="status" aria-live="polite"></p></>}</div></div>}
 </section>
</Base>
