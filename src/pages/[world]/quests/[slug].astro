---
import Base from '../../../layouts/Base.astro';
import {quests,worlds,href,asset,type World,type Quest} from '../../../lib/data';
import GraphicText from '../../../components/GraphicText.astro';
import '../../../styles/inner.css';
export function getStaticPaths(){return quests.map(quest=>({params:{world:quest.world,slug:quest.slug},props:{quest}}))}
const {quest:q}=Astro.props as {quest:Quest};const w=worlds[q.world];
const horrorLines:Record<string,string>={'palata-06':'В шестой палате никто не спит.','ne-otvechay':'Некоторые звонки лучше пропустить.','poslednyaya-smena':'В смене есть кто-то лишний.','lesnik':'Лес помнит ваши шаги.'};
---
<Base world={q.world} title={`${q.name} — ИНОЕ / ${w.name}`} description={q.synopsis}>
 <section class:list={['detail-hero',`detail-${q.world}`]}>
  <img class="detail-cover" src={asset(q.image)} alt={q.synopsis} fetchpriority="high" style="view-transition-name:quest-cover"/><div class="detail-shade"></div>
  <div class="detail-heading"><a href={href(`${q.world}/#quests`)} class="detail-back">{q.world==='iznanka'?'К выбору квеста':q.world==='arhiv'?'В галерею дел':'К карте приключений'}</a>{q.world!=='iznanka'&&<span class="eyebrow">ИНОЕ / {w.name} / {q.genre}</span>}<h1>{q.world==='iznanka'?<GraphicText text={q.name} variant="title" flicker/>:q.name}</h1><p>{q.synopsis}</p><a href={href(`${q.world}/book/${q.slug}/`)} class="button">Выбрать сеанс</a></div>{q.world!=='iznanka'&&<span class="detail-index" aria-hidden="true">{q.index}</span>}
  {q.world==='iznanka'&&<div class="horror-case-facts"><div><span>ВОЗРАСТ</span><strong>{q.age}</strong></div><div><span>ВРЕМЯ</span><strong>{q.duration} МИНУТ</strong></div><div><span>КОМАНДА</span><strong>{q.players.join('–')} ИГРОКОВ</strong></div><div><span>СТРАХ</span><strong>{q.level} / 5</strong></div></div>}
 </section>
 <section class="quest-story section-pad"><div><span class="section-index">СЮЖЕТ КВЕСТА</span><h2>{q.world==='iznanka'?horrorLines[q.slug]:q.world==='arhiv'?<>Случайностей<br/><em>не осталось.</em></>:<>Здесь всё<br/><em>начинается.</em></>}</h2></div><div class="story-copy"><p class="story-lead">{q.story}</p><div class="mission"><span class="eyebrow">ВАША ЗАДАЧА</span><p>{q.task}</p></div>{q.world!=='iznanka'&&<dl class="quest-metrics"><div><dt>{q.age}</dt><dd>Возраст</dd></div><div><dt>{q.duration} мин</dt><dd>Продолжительность</dd></div><div><dt>{q.players.join('–')}</dt><dd>Игроков</dd></div><div><dt>{q.level}<span> / 5</span></dt><dd>{q.label}</dd></div></dl>}</div></section>
 <section class="quest-gallery section-pad"><div class="gallery-head">{q.world==='iznanka'?<h2>Кадры квеста</h2>:<span class="section-index">КАДРЫ КВЕСТА</span>}<span>{q.world==='iznanka'?'Сгенерированные образы декораций':'Авторские образы декораций'}</span></div><div class="detail-gallery">{q.gallery.map((img,i)=><button class="gallery-image" data-lightbox-src={asset(img)} data-caption={`${q.name} — художественная сцена ${i+1}`} aria-label={`Увеличить изображение ${i+1}`}><img src={asset(img)} alt={`${q.name}: художественная сцена ${i+1}`} loading="lazy"/><span aria-hidden="true">+</span></button>)}</div></section>
 <section class="rules-book section-pad"><div><span class="section-index">ДО ВХОДА</span><h2>Важно<br/><em>знать.</em></h2><ul>{q.rules.map(r=><li>{r}</li>)}</ul><p class="demo-context">Это вымышленный сценарий. Описание площадки, контакты и стоимость уточняются при подключении реального квест-центра.</p></div><aside class="book-note"><span class="eyebrow">ВЫБРАННЫЙ КВЕСТ</span><h3>{q.name}</h3><p>{q.duration} минут / {q.players.join('–')} игроков / {q.age}</p><div class="booking-price"><span>Стоимость</span><strong>После подключения площадки</strong></div><a class="button" href={href(`${q.world}/book/${q.slug}/`)}>Выбрать сеанс</a><small>Доступна демонстрационная запись.<br/>Без оплаты и отправки данных.</small></aside></section>
 <section class="other-stories section-pad"><span class="section-index">ДРУГОЙ ПОВОРОТ</span><div>{quests.filter(x=>x.world===q.world&&x.slug!==q.slug).map(x=><a class="other-story" href={href(`${x.world}/quests/${x.slug}/`)}><img src={asset(x.image)} alt="" loading="lazy"/><h3>{x.name}</h3><span>Открыть</span></a>)}</div></section>
 <dialog class="lightbox" id="image-lightbox"><button class="dialog-close" aria-label="Закрыть изображение">×</button><img alt=""/><p></p></dialog>
</Base>

